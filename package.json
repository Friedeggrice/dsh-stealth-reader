{
  "name": "dsh-stealth-reader",
  "version": "0.5.0",
  "description": "底栏速记：在任意会话页面底部常驻几行文字，快捷键翻页，支持 txt 与 epub",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reader",
    "epub",
    "txt",
    "stealth"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "web",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "dsh-stealth-reader contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Friedeggrice/dsh-stealth-reader.git"
  },
  "homepage": "https://github.com/Friedeggrice/dsh-stealth-reader#readme",
  "bugs": {
    "url": "https://github.com/Friedeggrice/dsh-stealth-reader/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "manifestVersion": 1
  }
}
